<?xml version="1.0" encoding="utf-8"?>
<!--
  Outbound traffic policy (inbound connections to the runtime's own server are not affected by this file).
  ai.ask uses PolicyConfig.ai.baseUrl. Cleartext is allowed only for loopback; remote endpoints must use
  HTTPS. Add a host-specific exception here only when deliberately configuring a trusted HTTP endpoint.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
