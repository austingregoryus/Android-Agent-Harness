<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The call-audio permissions moved to the main manifest (conversation mode ships in release). -->
    <application>
        <!-- Debug only: exported so `adb shell am broadcast` can drive approvals and pairing on an emulator. -->
        <receiver
            android:name=".policy.ApprovalReceiver"
            android:exported="true"
            tools:replace="android:exported"
            tools:ignore="ExportedReceiver" />
        <receiver
            android:name=".core.DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
